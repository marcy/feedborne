package main

import "strconv"

templ IndexPage(data pageData) {
	<!DOCTYPE html>
	<html lang={ string(data.Lang) } data-theme={ string(data.Theme) }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>feedborne</title>
			<link rel="stylesheet" href="/static/style.css"/>
			<script src="/static/htmx.min.js"></script>
		</head>
		<body>
			<header>
				<span class="brand">feedborne</span>
				<span class="unread" id="unread">{ data.Msg.UnreadText(data.Unread) }</span>
				<span class="controls">
					<span class="seg">
						<a href="/lang?set=en" class={ templ.KV("current", data.Lang == LangEN) }>EN</a>
						<a href="/lang?set=ja" class={ templ.KV("current", data.Lang == LangJA) }>日本語</a>
					</span>
					<span class="seg">
						<a href="/theme?set=dark" class={ templ.KV("current", data.Theme == ThemeDark) }>Dark</a>
						<a href="/theme?set=light" class={ templ.KV("current", data.Theme == ThemeLight) }>Light</a>
						<a href="/theme?set=sepia" class={ templ.KV("current", data.Theme == ThemeSepia) }>Sepia</a>
					</span>
				</span>
			</header>
			<div class="layout">
				@FeedsSidebar(data.Feeds, data.Msg, data.Filter, data.SavedCount, data.Notion)
				<main id="list">
					<div class="col">
						if len(data.Entries) == 0 {
							if data.Filter == "saved" {
								<div class="empty">{ data.Msg.EmptySaved }</div>
							} else {
								<div class="empty">{ data.Msg.EmptyLead }<code>feedborne crawl</code>{ data.Msg.EmptyTail }</div>
							}
						}
						for _, e := range data.Entries {
							@EntryItem(e, data.Msg, data.Notion)
						}
						@MoreButton(data.HasMore, data.NextOffset, data.Msg, data.Filter)
					</div>
				</main>
			</div>
			<script src="/static/app.js"></script>
		</body>
	</html>
}

templ EntryItem(e Entry, msg Messages, notion bool) {
	<article class={ "entry", templ.KV("read", e.Read) } data-id={ strconv.FormatInt(e.ID, 10) } data-url={ e.URL }>
		<span class="dot"></span>
		<div class="entry-body">
			<div class="meta">
				<span class="feed">{ e.FeedTitle }</span>
				<span class="acts">
					@SaveButton(e, msg)
					if notion {
						@BookmarkButton(e, msg, "")
					}
				</span>
				<span class="time">{ formatTime(e.PublishedAt) }</span>
			</div>
			<h2><a href={ templ.URL(e.URL) } target="_blank" rel="noopener">{ e.Title }</a></h2>
			if e.Description != "" {
				<p>{ shortText(e.Description, 140) }</p>
			}
		</div>
	</article>
}

templ SaveButton(e Entry, msg Messages) {
	<button type="button" class={ "act save-btn", templ.KV("on", e.Saved) } hx-post={ "/save?id=" + strconv.FormatInt(e.ID, 10) } hx-target="this" hx-swap="outerHTML" title={ msg.ReadLater + " (s)" }>★</button>
}

templ BookmarkButton(e Entry, msg Messages, errText string) {
	<button type="button" class={ "act bm-btn", templ.KV("on", e.Bookmarked), templ.KV("err", errText != "") } hx-post={ "/bookmark?id=" + strconv.FormatInt(e.ID, 10) } hx-target="this" hx-swap="outerHTML" title={ bookmarkTitle(msg, errText) }>Notion</button>
}

templ MoreButton(hasMore bool, nextOffset int, msg Messages, filter string) {
	if hasMore {
		<div class="more"><button type="button" hx-get={ entriesURL(nextOffset, filter) } hx-target="closest div" hx-swap="outerHTML">{ msg.LoadMore }</button></div>
	}
}

templ EntriesFrag(frag fragData) {
	for _, e := range frag.Entries {
		@EntryItem(e, frag.Msg, frag.Notion)
	}
	@MoreButton(frag.HasMore, frag.NextOffset, frag.Msg, frag.Filter)
}

templ FeedsSidebar(feeds []Feed, msg Messages, filter string, savedCount int, notion bool) {
	<aside class="sidebar" id="feedsbar">
		<nav class="side-nav">
			<a class={ "nav-row", templ.KV("current", filter != "saved") } href="/">{ msg.AllLabel }</a>
			<a class={ "nav-row", templ.KV("current", filter == "saved") } href="/?filter=saved">{ msg.ReadLater }<span class="count">{ strconv.Itoa(savedCount) }</span></a>
		</nav>
		<div class="side-head">{ msg.FeedsLabel }</div>
		<nav class="feed-list">
			for _, f := range feeds {
				<div class="feed-row">
					if f.Title != "" {
						{ f.Title }
					} else {
						{ f.URL }
					}
				</div>
			}
		</nav>
		<div class="side-foot">
			<form hx-post="/feeds" hx-target="#feedsbar" hx-swap="outerHTML">
				<input type="hidden" name="filter" value={ filter }/>
				<input type="url" name="url" placeholder="https://example.com/feed.rss" required="required"/>
				<button type="submit">{ msg.AddFeed }</button>
			</form>
			<p class="keys">
				<kbd>j</kbd> { msg.KeyNext } <kbd>k</kbd> { msg.KeyPrev } <kbd>o</kbd> { msg.KeyOpen } <kbd>s</kbd> { msg.KeySave } <kbd>l</kbd> { msg.KeyView }
				if notion {
					<kbd>b</kbd> { msg.KeyBookmark }
				}
			</p>
		</div>
	</aside>
}
